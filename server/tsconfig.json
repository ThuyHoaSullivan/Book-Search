// server/tsconfig.json
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",             // ← ESM modules, Node style
    "moduleResolution": "NodeNext",   // ← resolve .js to .ts at build time
    "target": "ES2020",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src"]
}
